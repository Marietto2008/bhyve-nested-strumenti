#!/bin/sh
# vmm-azione -- Claude 31/10-01/11/2026, pareri Opus (separazione par. 3; «letture chiuse» 3.1-3.5; «wrapper di root» par. 2).
# COPIA INSTALLATA: /usr/local/sbin/vmm-azione, root:wheel 0555 (write_files). PREPARATA OFFLINE, NON INSTALLATA.
# Wrapper ROOT, l'UNICA via per le operazioni d'host che cambiano stato. Fa solo: controllo root, DECISIONE
# (vmm_azione_valuta, nella libreria INSTALLATA di root, collaudata senza privilegi dalla sorgente), gettone valido per
# l'operazione decisa, copia di root degli artefatti del workspace (verificata sulla COPIA), registro, esecuzione.
# Carica SOLO /usr/local/libexec/claude-vmm/gettone-lib.sh; legge il workspace da /usr/local/etc/claude-vmm.conf.
# RESIDUO DICHIARATO: nella finestra di validita' il gettone vale per QUALUNQUE processo di marietto, non solo per la
# sequenza autorizzata (non per i collaudi: collaudo non ha sudo). Finestre brevi: per una sequenza KUT, 1 ora.
set -u
PATH=/bin:/usr/bin:/sbin:/usr/sbin
CONF=/usr/local/etc/claude-vmm.conf
G=/var/run/claude-gettone
D=/var/log/claude-vmm-azione.log
SD=/var/db/claude-vmm-azione
VA_ART=$SD/art
registra() { [ "$(id -u)" = 0 ] && echo "$(date '+%F %T') $*" >> $D; return 0; }
rifiuta() { registra "RIFIUTO $*"; echo "vmm-azione: RIFIUTO: $*" >&2; exit 4; }
[ "$(id -u)" = 0 ] || rifiuta "non sono root"
# la libreria si carica solo DOPO il controllo di root, e solo dalla copia installata
VL_DIR=/usr/local/libexec/claude-vmm
. /usr/local/libexec/claude-vmm/gettone-lib.sh
W=$(sed -n 's/^area_di_lavoro=//p' "$CONF" 2>/dev/null)
case "$W" in /*) ;; *) rifiuta "area_di_lavoro assente in $CONF";; esac
L=$W/APPROVATI-sequenza.sha256
# letture vere per la decisione (eseguite come root, senza argomenti dell'utente)
va_ctime()  { stat -f '%c' "/dev/vmm/$1" 2>/dev/null; }
va_memseg() { ( set -o pipefail; bhyvectl --vm="$1" --get-memseg 2>&1 | sha256 -q ); }
# originali del kenv: registrati come root alla PRIMA operazione kenv della finestra del gettone (stato root, non nel
# workspace di marietto), per ammettere il ripristino esatto
kenv_ora() { if kenv -q "$1" >/dev/null 2>&1; then kenv -q "$1"; else echo "<assente>"; fi; }
kenv_stato() { echo "$SD/kenv-$(sed -n 's/^creato //p' "$G" 2>/dev/null)"; }
va_kenv_originale() {
	f=$(kenv_stato)
	if [ -f "$f" ]; then awk -F'\t' -v k="$1" '$1 == k {print $2}' "$f"; else kenv_ora "$1"; fi
}
va_blocklist() {
	for u in $(pciconf -l | awk -F'[@:]' '/^ppt[0-9]/ {sub(/^ppt/, "", $1); print $1}'); do
		devmatch -p "? at $(sysctl -n dev.ppt.$u.%location 2>/dev/null) $(sysctl -n dev.ppt.$u.%pnpinfo 2>/dev/null) on $(sysctl -n dev.ppt.$u.%parent 2>/dev/null)" 2>/dev/null
	done | sed 's/\.ko$//' | sort -u | tr '\n' ' ' | sed 's/ $//'
}
v=$(vmm_azione_valuta "$L" "$G" "$(date +%s)" 0 "$@") || rifiuta "$*: ${v#RIFIUTO }"
op=$(echo "$v" | sed -n '1s/^OP //p'); m=$(echo "$v" | sed -n '2s/^GETTONE //p')
# copie di root degli artefatti (par. 2.2c): copia, sha DELLA COPIA, poi si usa la copia
for c in $(echo "$v" | sed -n 's/^COPIA \([^ ]*\) \([0-9a-f]\{64\}\)$/\1:\2/p'); do
	src=${c%:*}; h=${c##*:}; dst=$VA_ART/$h/vmm-restore.ko
	mkdir -p -m 700 "$VA_ART/$h" || rifiuta "copia: cartella $VA_ART/$h"
	install -o root -g wheel -m 0400 "$src" "$dst.nuovo" && mv -f "$dst.nuovo" "$dst" || rifiuta "copia di $src non riuscita"
	[ "$(sha256 -q "$dst")" = "$h" ] || rifiuta "la COPIA di $src ha sha $(sha256 -q "$dst"), approvato $h"
	registra "COPIA $src -> $dst (sha verificato sulla copia)"
done
case "$(echo "$v" | sed -n '3,$p' | grep -v '^COPIA ' | head -1)" in /bin/kenv)
	f=$(kenv_stato)
	[ -f "$f" ] || { mkdir -p -m 700 "$SD" && printf 'boot_safe\t%s\ndevmatch_blocklist\t%s\n' "$(kenv_ora boot_safe)" "$(kenv_ora devmatch_blocklist)" > "$f"; } || rifiuta "stato degli originali del kenv non scrivibile";;
esac
IFS='
'
set -f; set -- $(echo "$v" | sed 1,2d | grep -v '^COPIA '); set +f
unset IFS
registra "ESEGUO ($op, $m): $*"
"$@"; r=$?
registra "FINE rc=$r: $*"
exit $r
