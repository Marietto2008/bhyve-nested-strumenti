#!/bin/sh
# Iniezioni di int 0x2d in L2: RIP all'ingresso, fonte (VMCS12 o L0), esito.
O=/mnt/linuxulator2/vm/nested-work/logs/int2d-$(date +%Y%m%d-%H%M)
mkdir -p $O
N=/mnt/linuxulator2/vm/nested-work/freebsd-nested/tools/nested
D=/mnt/linuxulator2/vm/nested-work/dtrace
DISPLAY=:0; XAUTHORITY=/home/marietto/.Xauthority; export DISPLAY XAUTHORITY
mount | grep -q "/mnt/da0p2" || sudo -n mount -t ufs /dev/da0p2 /mnt/da0p2
echo "output in $O"
for k in 1 2 3; do
  echo "######## corsa $k  $(date +%H:%M:%S)"
  sudo -n sysctl hw.vmm.vmx.diag_vec=45 hw.vmm.vmx.diag_slot=768 >/dev/null
  sudo -n bhyvectl --vm=vm0:12 --destroy 2>/dev/null
  sudo -n dtrace -s $D/win-diag.d     -o $O/i$k-diag.txt 2>/dev/null &
  sudo -n dtrace -s $D/win-bugcheck.d -o $O/i$k-bugcheck.txt 2>/dev/null &
  sleep 4
  sudo -n sh $N/12-Windows-11-vm12-senza-gpu > $O/i$k-script.log 2>&1 &
  i=0; while [ $i -lt 60 ]; do [ -e /dev/vmm/vm0:12 ] && break; sleep 1; i=$((i+1)); done
  [ -e /dev/vmm/vm0:12 ] && { echo "  VM su; 75 s"; sleep 75; } || echo "  VM NON creata"
  b=$(pgrep -x bhyve); [ -n "$b" ] && { sudo -n kill -KILL $b; sleep 2; }
  sudo -n bhyvectl --vm=vm0:12 --destroy 2>/dev/null
  sudo -n pkill -INT -f "win-diag|win-bugcheck" 2>/dev/null; sleep 2
  sudo -n pkill -KILL -f "win-diag|win-bugcheck|vncviewer" 2>/dev/null; sleep 1
  echo "  iniezioni 0x2d catturate: $(grep -c '| ING ' $O/i$k-diag.txt)"
  echo "  ultimo tick: $(grep 'ultimo tick' $O/i$k-bugcheck.txt | tail -1)"
done
sudo -n sysctl hw.vmm.vmx.diag_vec=0 >/dev/null
ls /dev/vmm 2>/dev/null || echo "/dev/vmm pulito"
