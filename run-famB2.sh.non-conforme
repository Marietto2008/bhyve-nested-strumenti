#!/bin/sh
# Claude 24/10/2026 -- parere #39 §7.2: corsa di controllo della famiglia B con la sonda
# leggera dtrace/invB.d, senza i ping di claude_winhost (corretto alle 01:08), 4 VP veri, make -j4, vept_keep=1, vept_scan_retries=2 (baseline
# sperimentale a 4 VP), verifica HPA spenta. Memoria dell'host: vmstat 1 e swapinfo ogni
# 30 s per tutta la corsa.
B=/mnt/linuxulator2/vm/wsl2/fbsd
G=/usr/bin/grep
T=$(date +%Y%m%d-%H%M)
echo "######## FAMB2-r2: 4 VP, -j4, retry 2 $(date +%T)"
echo "== host prima: $(swapinfo -h | tail -1)"
vmstat -w 1 > $B/logs/famB2-vmstat-$T.txt &
VS=$!
( while :; do echo "$(date +%T) $(swapinfo -k | tail -1)"; sleep 30; done ) > $B/logs/famB2-swap-$T.txt &
SW=$!
# parere #40 §9: la guardia WSL in Windows si aggiorna a VM pronta e va in pausa appena la
# compilazione e' partita (kbuild.log con "make -j4"); si riprende a fine corsa
( w() { sshpass -f /home/marietto/.config/claude-wsl2/password-windows ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o LogLevel=ERROR marietto@win11 "$@" 2>&1; }
  k=0; until w "echo pronto" | $G -q pronto; do sleep 10; k=$((k+1)); [ $k -gt 90 ] && exit 1; done
  sh $B/guardia-win.sh aggiorna > /dev/null; sh $B/guardia-win.sh pausa-dopo kbuild.log "make -j4" ) > $B/logs/famB2-guardia-$T.txt 2>&1 &
sudo -n dtrace -s $B/dtrace/invB.d -o $B/logs/famB2-$T.txt 2>$B/logs/famB2-$T.err &
sleep 3
VMS=12-Windows-11-vm12-senza-gpu-4core KBS=kbuild4.sh sh $B/run-b1win.sh 1 0 FAMB2-r2 2 2>&1 | $G -E "topologia|^real|kernel rc|bhyve CPU|spegnimento|NON|USCITO|retry_2_success|retry_exhausted|zapped_race|faults_l0"
sudo -n pkill -TERM -f "invB.d"
kill $VS $SW
sh $B/guardia-win.sh riprendi >> $B/logs/famB2-guardia-$T.txt 2>&1
echo "== host dopo: $(swapinfo -h | tail -1)"
echo "######## FINE $(date +%T)"
