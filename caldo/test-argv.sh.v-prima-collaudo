#!/bin/sh
# test-argv.sh -- Claude 29/10/2026 (#117 P0). Argv EFFETTIVE delle funzioni di mc-sistema.sh che cambiano lo stato.
# `sudo` e' ridefinito come funzione che REGISTRA gli argomenti (uno per [ ]) e non esegue nulla.
set -u
D=$(cd "$(dirname "$0")" && pwd)
. "$D/mc-sistema.sh"
REG=""
sudo() { REG=""; for a in "$@"; do REG="$REG[$a]"; done; return 0; }
P=0; F=0
atteso() { if [ "$REG" = "$1" ]; then P=$((P+1)); echo "  ok   $REG"; else F=$((F+1)); echo "  FAIL ottenuto $REG / atteso $1"; fi; }
# la sostituzione funziona davvero? (se sudo vero partisse, REG resterebbe vuoto)
s_freeze;                                  atteso "[-n][/usr/sbin/devctl][freeze]"
s_thaw;                                    atteso "[-n][/usr/sbin/devctl][thaw]"
s_kenv_set boot_safe YES;                  atteso "[-n][/bin/kenv][boot_safe=YES]"
s_kenv_set devmatch_blocklist "if_cdce amdgpu"; atteso "[-n][/bin/kenv][devmatch_blocklist=if_cdce amdgpu]"
s_kenv_set devmatch_blocklist "";          atteso "[-n][/bin/kenv][devmatch_blocklist=]"
s_kenv_unset boot_safe;                    atteso "[-n][/bin/kenv][-u][boot_safe]"
s_kldunload;                               atteso "[-n][/sbin/kldunload][-n][vmm-restore.ko]"
s_kldload /boot/kernel/vmm-restore.ko;     atteso "[-n][/sbin/kldload][/boot/kernel/vmm-restore.ko]"
s_vm_destroy vm2;                          atteso "[-n][/usr/sbin/bhyvectl][--vm=vm2][--destroy]"
# kenv.c (r.39): divide al PRIMO '=' -> l'argv deve contenere 'nome=' esatto, mai 'nome+='
case "$(s_kenv_set devmatch_blocklist x; echo "$REG")" in *"+="*) F=$((F+1)); echo "  FAIL '+=' nell'argv";; *) P=$((P+1)); echo "  ok   nessun '+=' nell'argv";; esac
echo "SUMMARY: $P ok, $F FAIL"
[ $F = 0 ]
