#!/bin/sh
# vmm-residuo.sh -- Claude 30/10/2026, parere #142 (gestione AUTORIZZATA dei residui /dev/vmm). Un nodo /dev/vmm/vm2
# lasciato da QEMU (-accel bhyve lo distrugge solo al poweroff) si distrugge SOLO se e' esattamente quello che
# l'utente ha autorizzato: stesso nome, stesso ctime, stessa mappa di memoria (hash di bhyvectl --get-memseg).
#
#   vmm-residuo.sh --verifica                       sola lettura: identita' di ogni nodo (da mostrare all'utente)
#   vmm-residuo.sh --distruggi vm2 <ctime> <memseg> distrugge vm2 SOLO se ctime e hash memseg coincidono
#   vmm-residuo.sh --classifica-ritorno <cartella della sessione>|nessuna
#        #143 §5, sola lettura: quale ramo del ritorno vale DOPO una sessione (anche fallita o fermata al preflight):
#        (#144 §2, ordine fail-closed: EMERGENZA, poi OPERATORE, poi i rami che ammettono un'azione)
#        RAMO=GIA_RIPRISTINATO    /dev/vmm vuoto, modulo ORIGINALE (es. rc=5 di modulo-caldo): nessuno scambio
#        RAMO=NESSUN_NODO         /dev/vmm vuoto, modulo RIPFIX: nessuna distruzione, ritorno protetto del modulo
#        RAMO=NODO_DELLA_SESSIONE vm2 chiusa, creata da QUELLA sessione (ctime >= avvio e = manifest, stessa
#                                 memseg): stampa il --distruggi da far AUTORIZZARE all'utente per quell'istanza
#        RAMO=OPERATORE           vm2 aperta, processi VM o dtrace vivi, altri nodi, identita' dubbia: STOP, nessun
#                                 kldunload forzato
#        RAMO=EMERGENZA           nessun modulo vmm o hot-swap rimasto a meta': protocollo d'emergenza di
#                                 modulo-caldo (stato.txt), nessun comando improvvisato
#
# Rifiuta (uscita 4, nulla fatto): nome diverso da vm2 (MAI vm0:12 o altri), nodo aperto, processi bhyve/qemu vivi,
# altri nodi oltre vm2 non sono un motivo di rifiuto ma non si toccano, ctime o memseg diversi, modulo vmm assente.
# Uscita 0 = distrutto e /dev/vmm/vm2 assente; 6 = distruzione tentata ma il nodo resta (operatore).
# Accesso al sistema solo dalle funzioni r_* (sovrascritte dal collaudo, test-vmm-residuo.sh).
set -u
r_nodi()    { /bin/ls /dev/vmm 2>/dev/null; }
r_ctime()   { /usr/bin/stat -f '%c' "/dev/vmm/$1" 2>/dev/null; }
r_memseg()  { sudo -n /usr/sbin/bhyvectl --vm="$1" --get-memseg 2>&1 | /sbin/sha256 -q; }
r_aperto()  { [ -n "$(sudo -n /usr/bin/fstat "/dev/vmm/$1" 2>/dev/null | /usr/bin/sed 1d)" ]; }
r_vm_vive() { /bin/ps -ax -o pid= -o comm= | /usr/bin/awk '$2 ~ /^(bhyve|qemu-system)/'; }
r_modulo()  { /sbin/kldstat -q -n vmm-restore.ko || /sbin/kldstat -q -n vmm.ko; }
r_distruggi() { sudo -n /usr/sbin/bhyvectl --vm="$1" --destroy; }
r_ora()     { /bin/date '+%F %T'; }
r_memseg_testo() { sudo -n /usr/sbin/bhyvectl --vm="$1" --get-memseg 2>&1 | /usr/bin/tr -s ' \n' ' '; }	# come nel manifest
r_dtrace_vivo()  { /bin/pgrep -x dtrace; }
# identita' del modulo caricato secondo mc-logica.sh: originale | ripfix-nested | h2ad2 | r110 | h2 |
# incompleto:<stato> | sconosciuto:<path> (path, sha e firma OID devono coincidere TUTTI)
r_modulo_id() {
	( . /mnt/linuxulator2/vm/wsl2/fbsd/caldo/mc-sistema.sh; . /mnt/linuxulator2/vm/wsl2/fbsd/caldo/mc-logica.sh
	  c=$(mc_caricato); case "$c" in "completo "*) p=${c#completo };; *) echo "incompleto:$c"; exit 0;; esac
	  for i in originale ripfix-nested h2ad2 r110 h2; do
		set -- $(mc_identita $i)
		[ "$p" = "$1" ] && [ "$(s_sha "$p")" = "$2" ] && mc_oid_ok "$p" && { echo $i; exit 0; }
	  done
	  echo "sconosciuto:$p" )
}
r_fase_caldo()   { /usr/bin/sed -n 's/^fase=//p' /mnt/linuxulator2/vm/wsl2/fbsd/logs/modulo-caldo/stato.txt 2>/dev/null; }
[ -n "${VR_FINTO:-}" ] && . "$VR_FINTO"
VR_DIARIO=${VR_DIARIO:-/mnt/linuxulator2/vm/wsl2/fbsd/logs/vmm-residuo/diario.txt}

vr_dice() { echo "$*"; [ "${VR_SCRIVI:-0}" = 1 ] && echo "$(r_ora) $*" >> "$VR_DIARIO"; return 0; }
vr_stop() { vr_dice "RIFIUTO: $*; nulla fatto"; exit 4; }

vr_identita() {	# stampa una riga per nodo: nome ctime memseg aperto
	for n in $(r_nodi); do
		a=no; r_aperto "$n" && a=si
		echo "$n ctime=$(r_ctime "$n") memseg=$(r_memseg "$n") aperto=$a"
	done
}

case "${1:-}" in
--verifica)
	[ $# = 1 ] || { echo "uso: $0 --verifica"; exit 4; }
	r_modulo || vr_stop "nessun modulo vmm caricato"
	v=$(r_vm_vive); [ -n "$v" ] && echo "processi VM vivi: $v"
	i=$(vr_identita)
	[ -n "$i" ] && echo "$i" || echo "/dev/vmm vuoto"
	exit 0;;
--distruggi)
	[ $# = 4 ] || { echo "uso: $0 --distruggi vm2 <ctime> <memseg>"; exit 4; }
	n=$2; c=$3; m=$4
	mkdir -p "$(dirname "$VR_DIARIO")" && VR_SCRIVI=1
	[ "$n" = vm2 ] || vr_stop "solo vm2 (residuo di QEMU) si distrugge con questo strumento, non '$n'"
	r_modulo || vr_stop "nessun modulo vmm caricato"
	v=$(r_vm_vive); [ -n "$v" ] && vr_stop "VM viva: $(echo "$v" | tr '\n' ' ')"
	r_nodi | grep -qx vm2 || vr_stop "/dev/vmm/vm2 non esiste"
	r_aperto vm2 && vr_stop "/dev/vmm/vm2 e' aperto"
	c0=$(r_ctime vm2); m0=$(r_memseg vm2)
	[ "$c0" = "$c" ] || vr_stop "ctime di vm2 $c0, autorizzato $c: NON e' il nodo autorizzato"
	[ "$m0" = "$m" ] || vr_stop "memseg di vm2 $m0, autorizzato $m: NON e' il nodo autorizzato"
	vr_dice "vm2 ctime=$c0 memseg=$m0 chiuso, nessuna VM viva: distruggo (autorizzato)"
	r_distruggi vm2; rc=$?
	if r_nodi | grep -qx vm2; then vr_dice "ESITO 6: bhyvectl --destroy rc=$rc ma /dev/vmm/vm2 resta. Operatore."; exit 6; fi
	vr_dice "ESITO 0: vm2 distrutto (rc=$rc); /dev/vmm: $(r_nodi | tr '\n' ' ')"
	exit 0;;
--classifica-ritorno)
	[ $# = 2 ] || { echo "uso: $0 --classifica-ritorno <cartella della sessione>|nessuna"; exit 4; }
	# 1. EMERGENZA: hot-swap rimasto a meta', nessun modulo, modulo incompleto
	f=$(r_fase_caldo)
	case "${f:-fine}" in fine|nulla) ;; *) echo "RAMO=EMERGENZA hot-swap rimasto nella fase '$f' (logs/modulo-caldo/stato.txt): protocollo di modulo-caldo, nessun comando improvvisato"; exit 0;; esac
	r_modulo || { echo "RAMO=EMERGENZA nessun modulo vmm caricato: protocollo di modulo-caldo, nessun comando improvvisato"; exit 0; }
	mid=$(r_modulo_id)
	case "$mid" in incompleto:*) echo "RAMO=EMERGENZA modulo caricato non completo ($mid): protocollo di modulo-caldo"; exit 0;; esac
	# 2. OPERATORE, qualunque sia /dev/vmm: processi VM, dtrace, altri nodi, vm2 aperta, modulo non previsto
	v=$(r_vm_vive); [ -n "$v" ] && { echo "RAMO=OPERATORE processi VM vivi: $(echo "$v" | tr '\n' ' ')"; exit 0; }
	v=$(r_dtrace_vivo); [ -n "$v" ] && { echo "RAMO=OPERATORE dtrace vivo ($(echo "$v" | tr '\n' ' ')): il kldunload sarebbe rifiutato"; exit 0; }
	altri=$(r_nodi | grep -vx -e vm2 -e '' | tr '\n' ' ')
	[ -n "$altri" ] && { echo "RAMO=OPERATORE nodi /dev/vmm diversi da vm2: $altri"; exit 0; }
	r_nodi | grep -qx vm2 && r_aperto vm2 && { echo "RAMO=OPERATORE /dev/vmm/vm2 e' aperto"; exit 0; }
	case "$mid" in originale|ripfix-nested) ;; *) echo "RAMO=OPERATORE modulo caricato non previsto dalla campagna: $mid"; exit 0;; esac
	# 3. /dev/vmm vuoto: il ramo dipende dal modulo EFFETTIVAMENTE caricato
	if ! r_nodi | grep -qx vm2; then
		[ "$mid" = originale ] && { echo "RAMO=GIA_RIPRISTINATO /dev/vmm vuoto e modulo originale gia' caricato: nessuno scambio; solo smoke-modulo.sh originale"; exit 0; }
		echo "RAMO=NESSUN_NODO /dev/vmm vuoto, modulo ripfix-nested, nessun processo VM o dtrace: ritorno protetto senza distruzione (modulo-caldo.sh --esegui ripfix-nested originale)"; exit 0
	fi
	# 4. vm2 chiusa: solo se e' quella del manifest della sessione indicata
	[ "$2" = nessuna ] && { echo "RAMO=OPERATORE vm2 presente ma nessuna sessione di riferimento: identita' non attribuibile"; exit 0; }
	riga=$(grep -m1 '^vm2 dopo: creata ' "$2/manifest.txt" 2>/dev/null)
	[ -n "$riga" ] || { echo "RAMO=OPERATORE vm2 presente ma il manifest di $2 non registra la vm2 della sessione"; exit 0; }
	mc=$(echo "$riga" | sed -n 's/^vm2 dopo: creata \([0-9]*\) (avvio sessione [0-9]*) .*$/\1/p')
	ma=$(echo "$riga" | sed -n 's/^vm2 dopo: creata [0-9]* (avvio sessione \([0-9]*\)) .*$/\1/p')
	mm=$(echo "$riga" | sed -n 's/^vm2 dopo: creata [0-9]* (avvio sessione [0-9]*) \(.*\)$/\1/p')
	c0=$(r_ctime vm2)
	# 5. ogni altro caso: OPERATORE
	if [ -z "$mc" ] || [ -z "$ma" ] || [ "$c0" != "$mc" ] || [ "$mc" -lt "$ma" ] || [ "$(r_memseg_testo vm2)" != "$mm" ]; then
		echo "RAMO=OPERATORE vm2 (ctime $c0) non e' quella registrata dalla sessione (ctime $mc, avvio $ma) o memseg diversa"; exit 0
	fi
	echo "RAMO=NODO_DELLA_SESSIONE vm2 creata dalla sessione $2 (ctime $c0 >= avvio $ma), chiusa, nessuna VM o dtrace viva"
	echo "  da AUTORIZZARE per questa istanza: sh $0 --distruggi vm2 $c0 $(r_memseg vm2)"
	echo "  modulo caricato: $mid; dopo la distruzione RICLASSIFICARE prima di qualunque ritorno"
	exit 0;;
*) echo "uso: $0 --verifica | --distruggi vm2 <ctime> <memseg> | --classifica-ritorno <sessione>|nessuna"; exit 4;;
esac
