/*
 * kvm-episodi-linux2.bt -- Claude 11/11/2026, seconda versione di kvm-episodi-linux.bt (schema di Fable, risposta al 023).
 * Differenze: (1) kvm_page_fault conta solo se guest_rip e' nella pagina di lapic_et_start 0xffffffff8120b000, come il
 * registratore bhyve (nested_diag_pfrec_rippage): toglie le false coppie della classe «altro» (esiti.md 11/11 10:10);
 * (2) @qual (distribuzione di exit_info1) stampata ogni 60 s, non solo in END: alle 10:30 la prima versione e' stata
 * chiusa senza END e la distribuzione e' andata persa.
 * Classi: 0 = rientro a rip0+6, 1 = altro, 2 = fermo (rip0); ev = evento iniettato al rientro.
 * Uso: sudo bpftrace kvm-episodi-linux2.bt > ../dati-kvm/episodi2-<ora>.txt
 */
tracepoint:kvm:kvm_nested_vmenter
{
	$p = args->vmcb;
	@cur[tid] = $p;
	$r0 = @pend[$p];
	if ($r0 != 0) {
		$ev = (args->event_inj & 0x80000000) != 0 ? 1 : 0;
		$cls = args->nested_rip == $r0 ? 2 : (args->nested_rip == $r0 + 6 ? 0 : 1);
		@e0c[$cls, $ev] = count();
		if ($cls == 2 && args->event_inj == 0x80000b0e) {
			printf("%s #PF FERMO: vmcs12 %lx rip %lx eptp12 %lx idtv_ultima_48 %x\n", strftime("%H:%M:%S", nsecs),
			    $p, args->nested_rip, args->guest_pgd, @idtv[$p]);
		}
		delete(@pend[$p]);
	}
}

tracepoint:kvm:kvm_page_fault
/(args->fault_address == 0xfee00380 || args->fault_address == 0xfee00320) &&
 (args->guest_rip & 0xfffffffffffff000) == 0xffffffff8120b000/
{
	@pfrip[tid] = args->guest_rip;
	@pft[tid] = nsecs;
}

tracepoint:kvm:kvm_nested_vmexit_inject
/args->exit_code == 48/
{
	$p = @cur[tid];
	@idtv[$p] = args->exit_info2;
	if (@pfrip[tid] != 0 && nsecs - @pft[tid] < 50000) {
		@pend[$p] = @pfrip[tid];
		@episodi = count();
		@qual[args->exit_info1] = count();
	}
	delete(@pfrip[tid]);
}

interval:s:60
{
	time("%H:%M:%S ");
	print(@episodi);
	print(@e0c);
	print(@qual);
}

END
{
	clear(@cur); clear(@pend); clear(@pfrip); clear(@pft); clear(@idtv);
}
