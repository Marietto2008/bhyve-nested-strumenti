+/*
+ * Fable 038: il difetto D3 dell'audit VPID del 25/10. Senza vpid_track il passaggio VMCS02 -> VMCS01 della
+ * riflessione scrive lastcpu = curcpu anche dal percorso lento (nested_ept_slow: tutte le 48 riflesse). Se il thread
+ * e' su una CPU diversa da quella dell'ingresso in L2, il vmx_run successivo trova lastcpu == curcpu e non invalida
+ * il VPID01: l'L1 riparte con le traduzioni che aveva lasciato su quella CPU prima di girare altrove. Con
+ * nested_d3_fix=1 la riflessione lenta lascia lastcpu = NOCPU e decide il vmx_run successivo, sulla CPU vera.
+ * Spento di base: A e B sono lo stesso modulo.
+ */
+static int nested_d3_fix = 0;
+SYSCTL_INT(_hw_vmm_vmx, OID_AUTO, nested_d3_fix, CTLFLAG_RWTUN, &nested_d3_fix, 0,
+    "nested: la riflessione dal percorso lento non rivendica la CPU (lastcpu = NOCPU; Fable 038, D3)");
+NESTED_CTR(vpid01_slowpath_noclaim, "nested: riflessioni dal percorso lento con lastcpu = NOCPU (nested_d3_fix)");
+/*
+ * Fable 038 §3.1, invariante del VPID01, sempre acceso, solo contatore: a ogni ingresso hardware dell'L1 sulla CPU
+ * c, o l'L1 ha girato per ultimo su c, o il VPID01 e' stato invalidato su c (INVVPID, o INVEPT dell'EPT01) dopo
+ * l'ultima esecuzione dell'L1. Senza la correzione deve salire; con la correzione, zero.
+ */
+NESTED_CTR(vpid01_invariant_viol, "nested: ingressi dell'L1 con il VPID01 non coerente su quella CPU (Fable 038)");
+/* Fable 036 §5.1: ingressi hardware in L2 con un interrupt dell'L1 pendente e consegnabile, con EXTINT exiting */
+NESTED_CTR(nested_l2entry_l1intr, "nested: ingressi in L2 con interrupt dell'L1 pendente, senza uscita immediata");
+NESTED_CTR(nested_l2entry_l1intr_imm, "nested: ingressi in L2 con interrupt dell'L1 pendente e uscita immediata armata");
+/* Fable 038 §4 punto 2: rinvii senza ripiego (l'uscita immediata non si arma) */
+NESTED_CTR(nested_immexit_noarm_l1timer, "nested: rinvio senza uscita immediata, l'L1 usa il suo timer di preemption");
+NESTED_CTR(nested_immexit_noarm_noimm, "nested: rinvio senza uscita immediata, timer di preemption non disponibile");
+
+/* le invalidazioni del VPID01 sulla CPU corrente (sezione critica di vmx_run) */
+void
+vmx_nested_vpid01_flushed(struct vmx_vcpu *vcpu)
+{
+	CPU_SET(curcpu, &vcpu->nested->l1_flushed);
+}
+
+/* subito prima dell'ingresso hardware, interrupt chiusi */
+void
+vmx_nested_entry_check(struct vmx_vcpu *vcpu)
+{
+	struct vmx_nested *n = vcpu->nested;
+	struct vmcs12_cache *c;
+	int me = curcpu, vec;
+
+	if (!n->in_l2) {
+		if (n->l1_last_cpu1 != 0 && n->l1_last_cpu1 != me + 1 &&
+		    !CPU_ISSET(me, &n->l1_flushed)) {
+			atomic_add_long(&vpid01_invariant_viol, 1);
+			nested_oprec_note(n, OPR_VIOL01, n->l1_last_cpu1, me);
+		}
+		n->l1_last_cpu1 = me + 1;
+		CPU_ZERO(&n->l1_flushed);
+		return;
+	}
+	c = nested_current_cache(n);
+	if (c == NULL ||
+	    (vmcs12_read_field(c, VMCS_PIN_BASED_CTLS) & PINBASED_EXTINT_EXITING) == 0 ||
+	    !vlapic_pending_intr(vm_lapic(vcpu->vcpu), &vec))
+		return;
+	atomic_add_long(n->imm_armed ? &nested_l2entry_l1intr_imm : &nested_l2entry_l1intr, 1);
+}
+
+/*
+ * Fable 038 §3.4, amplificatore Mk2 (controllo positivo di D3), solo diagnostica, spento di base. Durante
+ * l'emulazione di un episodio sorvegliato (riflessione 48 sulla pagina del LAPIC con RIP a ...ripoff), nel percorso
+ * lento di una VMREAD o VMWRITE dell'L1 scelta a caso (una su every), il thread passa su Y: Hyper-V finisce il gestore
+ * su Y, e l'L2 entra ed esce su Y. Al percorso lento della prossima EPT violation dell'L2 (nested_ept_slow, prima
+ * della riflessione) il thread torna su X. Modo 1: Y = l'altra CPU logica del core; modo 2: Y su un altro core.
+ */
+static u_int nested_diag_mk2 = 0;
+SYSCTL_UINT(_hw_vmm_vmx, OID_AUTO, nested_diag_mk2, CTLFLAG_RWTUN, &nested_diag_mk2, 0,
+    "nested, diagnostica: Mk2 (0 spento, 1 CPU sorella, 2 altro core; Fable 038 par. 3.4)");
+static u_int nested_diag_mk2_every = 4;
+SYSCTL_UINT(_hw_vmm_vmx, OID_AUTO, nested_diag_mk2_every, CTLFLAG_RWTUN, &nested_diag_mk2_every, 0,
+    "nested, diagnostica: Mk2 sposta il thread su una VMREAD/VMWRITE dell'emulazione ogni N (a caso)");
+static u_int nested_diag_mk2_ripoff = 0x831;
+SYSCTL_UINT(_hw_vmm_vmx, OID_AUTO, nested_diag_mk2_ripoff, CTLFLAG_RWTUN, &nested_diag_mk2_ripoff, 0,
+    "nested, diagnostica: Mk2 solo sugli episodi con RIP dell'L2 a questo offset nella pagina (0 = tutti)");
+NESTED_CTR(nested_diag_mk2_andate, "nested: Mk2, spostamenti su Y durante l'emulazione");
+NESTED_CTR(nested_diag_mk2_ritorni, "nested: Mk2, ritorni su X prima della riflessione lenta");
+NESTED_CTR(nested_diag_mk2_abbandoni, "nested: Mk2, ritorni non fatti (uscita dell'L2 riflessa dentro vmx_run)");
+
+/* all'apertura di un episodio (nested_pfrec_cap_e0) */
+static void
+nested_mk2_episodio(struct vmx_nested *n, uint64_t rip)
+{
+	n->mk2_ep = nested_diag_mk2 != 0 && n->mk2_ret == 0 &&
+	    (nested_diag_mk2_ripoff == 0 || (rip & PAGE_MASK) == nested_diag_mk2_ripoff);
+}
+
+/* all'inizio del percorso lento (nessun VMCS attivo, come Mk) */
+static void
+nested_mk2_percorso_lento(struct vmx_nested *n, uint32_t reason)
+{
+	int x, y;
+
+	if (n->mk2_ret != 0) {
+		if (!n->in_l2) {
+			/* ancora l'L1 su Y (resto dell'emulazione), oppure l'L2 e' gia' tornata in L1 dentro vmx_run */
+			if (n->mk2_in_l2) {
+				n->mk2_ret = 0;
+				n->mk2_in_l2 = false;
+				atomic_add_long(&nested_diag_mk2_abbandoni, 1);
+			}
+			return;
+		}
+		if (!n->ept_pending)	/* uscita dell'L2 che non sara' una riflessione lenta: si aspetta */
+			return;
+		nested_mk_sposta(n->mk2_ret - 1);
+		nested_oprec_note(n, OPR_MK2, 2, curcpu);
+		n->mk2_ret = 0;
+		n->mk2_in_l2 = false;
+		atomic_add_long(&nested_diag_mk2_ritorni, 1);
+		return;
+	}
+	if (!n->mk2_ep || n->in_l2 ||
+	    (reason != EXIT_REASON_VMREAD && reason != EXIT_REASON_VMWRITE))
+		return;
+	if (nested_diag_mk2_every > 1 && (rdtsc() >> 4) % nested_diag_mk2_every != 0)
+		return;
+	x = curcpu;
+	y = nested_diag_mk2 == 2 ? (x + 2) % mp_ncpus : (x ^ 1);
+	nested_mk_sposta(y);
+	n->mk2_ep = false;
+	n->mk2_ret = x + 1;
+	n->mk2_in_l2 = false;
+	nested_oprec_note(n, OPR_MK2, 1, curcpu);
+	atomic_add_long(&nested_diag_mk2_andate, 1);
+}
