From b21aebf5f273cecfc72ebe345bdd57c1eac5014f Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 14:49:54 +0100
Subject: [PATCH 5/5] virtio_console: send DEVICE_READY after DRIVER_OK

vtcon_attach() sends the VIRTIO_CONSOLE_DEVICE_READY control message and
busy-waits in vtcon_ctrl_poll() for the host to consume it.  This runs
inside the child's device_attach(), before the transport sets
VIRTIO_CONFIG_STATUS_DRIVER_OK, and a device is not required to process
any virtqueue before that.  The virtio console that Hyper-V attaches to
the WSL2 utility VM does not, so the boot hung forever right after
"using per VQ MSIX interrupts".

Send DEVICE_READY from the virtio_attach_completed method instead, which
the transport calls after DRIVER_OK, as virtio_blk does for
VIRTIO_BLK_T_GET_ID.  Linux likewise calls virtio_device_ready() before
sending DEVICE_READY.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/dev/virtio/console/virtio_console.c | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/sys/dev/virtio/console/virtio_console.c b/sys/dev/virtio/console/virtio_console.c
index 66433565c..0cd6ee530 100644
--- a/sys/dev/virtio/console/virtio_console.c
+++ b/sys/dev/virtio/console/virtio_console.c
@@ -151,6 +151,7 @@ static void	 vtcon_drain_all(void);
 
 static int	 vtcon_probe(device_t);
 static int	 vtcon_attach(device_t);
+static int	 vtcon_attach_completed(device_t);
 static int	 vtcon_detach(device_t);
 static int	 vtcon_config_change(device_t);
 
@@ -248,6 +249,7 @@ static device_method_t vtcon_methods[] = {
 	DEVMETHOD(device_detach,	vtcon_detach),
 
 	/* VirtIO methods. */
+	DEVMETHOD(virtio_attach_completed, vtcon_attach_completed),
 	DEVMETHOD(virtio_config_change,	vtcon_config_change),
 
 	DEVMETHOD_END
@@ -369,9 +371,6 @@ vtcon_attach(device_t dev)
 
 	vtcon_enable_interrupts(sc);
 
-	vtcon_ctrl_send_control(sc, VIRTIO_CONSOLE_BAD_ID,
-	    VIRTIO_CONSOLE_DEVICE_READY, 1);
-
 fail:
 	if (error)
 		vtcon_detach(dev);
@@ -379,6 +378,26 @@ vtcon_attach(device_t dev)
 	return (error);
 }
 
+static int
+vtcon_attach_completed(device_t dev)
+{
+	struct vtcon_softc *sc;
+
+	sc = device_get_softc(dev);
+
+	/*
+	 * Tell the host we are ready only once it has been told
+	 * VIRTIO_CONFIG_STATUS_DRIVER_OK: a device may not process the
+	 * control virtqueue before that, and vtcon_ctrl_poll() would then
+	 * spin forever.  The virtio console that Hyper-V attaches to the WSL2
+	 * utility VM does exactly that.
+	 */
+	vtcon_ctrl_send_control(sc, VIRTIO_CONSOLE_BAD_ID,
+	    VIRTIO_CONSOLE_DEVICE_READY, 1);
+
+	return (0);
+}
+
 static int
 vtcon_detach(device_t dev)
 {
