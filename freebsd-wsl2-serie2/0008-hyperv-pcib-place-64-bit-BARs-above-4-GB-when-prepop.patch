From f5e996ea4a7dd744cd56c84e8a943f3a1763960a Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 01:47:52 +0100
Subject: [PATCH 8/9] hyperv/pcib: place 64-bit BARs above 4 GB when
 prepopulating

As Linux does.  Allocating from anywhere put a 64-bit BAR of the virtio
console in the low MMIO window and the guest hung attaching it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/dev/hyperv/pcib/vmbus_pcib.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/sys/dev/hyperv/pcib/vmbus_pcib.c b/sys/dev/hyperv/pcib/vmbus_pcib.c
index da65ae3fc..fa6bb732b 100644
--- a/sys/dev/hyperv/pcib/vmbus_pcib.c
+++ b/sys/dev/hyperv/pcib/vmbus_pcib.c
@@ -1486,8 +1486,20 @@ vmbus_pcib_prepopulate_bars(struct hv_pcibus *hbus)
 			flags = RF_ALIGNMENT_LOG2(flsll(size) - 1);
 			if (probed & PCIM_BAR_MEM_PREFETCH)
 				flags |= RF_PREFETCHABLE;
-			res = bus_alloc_resource(hbus->pcib, SYS_RES_MEMORY,
-			    &rid, 0, is64 ? ~0 : 0xffffffff, size, flags);
+			/*
+			 * 64-bit BARs go above 4 GB, as Linux places them: a
+			 * 64-bit BAR of the virtio console put in the low MMIO
+			 * window left the guest unable to use the device.
+			 */
+			res = NULL;
+			if (is64)
+				res = bus_alloc_resource(hbus->pcib,
+				    SYS_RES_MEMORY, &rid, 0x100000000ULL, ~0,
+				    size, flags);
+			if (res == NULL)
+				res = bus_alloc_resource(hbus->pcib,
+				    SYS_RES_MEMORY, &rid, 0,
+				    is64 ? ~0 : 0xffffffff, size, flags);
 			if (res == NULL) {
 				device_printf(hbus->pcib, "no room for BAR %d "
 				    "(%#jx bytes) of device slot %#x\n", i,
-- 
