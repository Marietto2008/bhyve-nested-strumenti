# Secondary Bus Reset on the RTX 2080Ti passthrough functions: plain FLR/power-state
# reset (done automatically on assign/unassign) isn't enough for this GPU and leaves
# it in a state that freezes the host on the next vmm reload/VM relaunch. Use a
# throwaway vm0:12 context just to get an fd to issue the SBR ioctl through.
sudo /usr/sbin/bhyvectl --vm=vm0:12 --create
sudo /usr/sbin/bhyvectl --vm=vm0:12 --pptdev-sbr=4/0/0
sudo /usr/sbin/bhyvectl --vm=vm0:12 --pptdev-sbr=4/0/1
sudo /usr/sbin/bhyvectl --vm=vm0:12 --pptdev-sbr=4/0/2
sudo /usr/sbin/bhyvectl --vm=vm0:12 --pptdev-sbr=4/0/3
sudo /usr/sbin/bhyvectl --vm=vm0:12 --destroy
sleep 5

