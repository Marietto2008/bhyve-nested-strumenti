#!/bin/sh
# Claude 23/10/2026 -- parere #38 (pmap): spin in ns, stack campionati e thread entranti, con la sonda
# leggera dtrace/pmap2.d, 4 VP veri, make -j4, vept_keep=1, vept_scan_retries=2 (baseline
# sperimentale a 4 VP), verifica HPA spenta. Memoria dell'host: vmstat 1 e swapinfo ogni
# 30 s per tutta la corsa.
B=/mnt/linuxulator2/vm/nested-work
G=/usr/bin/grep
T=$(date +%Y%m%d-%H%M)
echo "######## PMAP2: 4 VP, -j4, retry 2 $(date +%T)"
echo "== host prima: $(swapinfo -h | tail -1)"
vmstat -w 1 > $B/logs/pmap2-vmstat-$T.txt &
VS=$!
( while :; do echo "$(date +%T) $(swapinfo -k | tail -1)"; sleep 30; done ) > $B/logs/pmap2-swap-$T.txt &
SW=$!
sudo -n dtrace -s $B/dtrace/pmap2.d -o $B/logs/pmap2-$T.txt 2>$B/logs/pmap2-$T.err &
sleep 3
VMS=12-Windows-11-vm12-senza-gpu-4core KBS=kbuild4.sh sh $B/run-b1win.sh 1 0 PMAP2-r2 2 2>&1 | $G -E "topologia|^real|kernel rc|bhyve CPU|spegnimento|NON|USCITO|retry_2_success|retry_exhausted|zapped_race|faults_l0"
sudo -n pkill -TERM -f "pmap2.d"
kill $VS $SW
echo "== host dopo: $(swapinfo -h | tail -1)"
echo "######## FINE $(date +%T)"
