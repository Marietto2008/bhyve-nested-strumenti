# ---------------------------------------------------------------- kut-drive.py v2 contro finte QEMU
print('kut-drive.py')
def finta(nome, corpo):
	f = os.path.join(W, 'finta-%s.py' % nome)
	open(f, 'w').write('import sys, time\n' + textwrap.dedent(corpo))
	return f
def drive(nome, atteso, f, regole, foto_cmd='echo vm\\ exits\\ for\\ instruction\\ emulation\\ 5', timeout=10,
    controllo=None):
	d = os.path.join(W, 'drv-' + nome)
	a = [PY, B + '/kut-drive.py', '--out', d, '--timeout', str(timeout), '--foto-timeout', '5']
	for r in regole:
		a += ['--regola', r]
	if foto_cmd:
		a += ['--foto-cmd', foto_cmd]
	p = subprocess.run(a + ['--', PY, f], capture_output=True, text=True)
	out = p.stdout + p.stderr
	if controllo and p.returncode == atteso:
		ok, m = controllo(d)
		if not ok:
			out = 'CONTROLLO: ' + m
			p.returncode = 'controllo'
	esito('drive ' + nome, p.returncode, atteso, out)
FLUSSO = '''
print('U64 PRONTO', flush=True)
g = sys.stdin.readline()
print('U64 MISURA APERTA', flush=True)
print('U64 FINESTRA APERTA', flush=True)
print('U64 FINE casi=28 modello=28 contrari=0', flush=True)
f = sys.stdin.readline()
print('U64 CHIUSO' if f.strip() == 'f' else 'U64 CHIUSURA MANCATA', flush=True)
'''
def foto_finale_dopo_record(d):
	st = json.load(open(os.path.join(d, 'stato.json')))
	r = [x for x in st['regole'] if x['testo'] == 'U64 FINE casi='][0]
	ser = open(os.path.join(d, 'seriale.txt')).read()
	return (r['stato'] == 'fatta' and 'U64 CHIUSO' in ser and len(st['invii']) == 2,
	    'regola finale %s, invii %d, CHIUSO %s' % (r['stato'], len(st['invii']), 'U64 CHIUSO' in ser))
drive('flusso_completo', 0, finta('flusso', FLUSSO), ['U64 PRONTO|foto|g', 'U64 FINE casi=|foto|f'],
    controllo=foto_finale_dopo_record)
def senza_invio(d):
	st = json.load(open(os.path.join(d, 'stato.json')))
	return (not st['invii'], 'invii %r' % st['invii'])
drive('foto_fallita_niente_g', 2, finta('attesa', '''
print('U64 PRONTO', flush=True)
g = sys.stdin.readline()
print('RICEVUTO ' + g.strip(), flush=True)
'''), ['U64 PRONTO|foto|g'], foto_cmd='exit 7', controllo=senza_invio)
drive('foto_timeout', 2, finta('attesa2', '''
print('U64 PRONTO', flush=True)
time.sleep(30)
'''), ['U64 PRONTO|foto|g'], foto_cmd='sleep 20', timeout=40)
drive('timeout_sessione', 2, finta('lenta', '''
print('U64 PRONTO', flush=True)
time.sleep(60)
'''), ['U64 PRONTO||g'], foto_cmd='', timeout=2)
drive('regola_mai_scattata', 2, finta('corta', '''
print('altro', flush=True)
'''), ['U64 PRONTO||g'], foto_cmd='')
drive('regole_ambigue', 1, finta('x', 'pass\n'), ['U64 FINE|foto|', 'U64 FINE casi=|foto|f'])
def figlio_morto(d):
	st = json.load(open(os.path.join(d, 'stato.json')))
	return (not any('ancora vivo' in e for e in st['errori']), '%r' % st['errori'])
drive('discendente_persistente', 0, finta('padre', '''
import subprocess
subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(120)'])
print('fatto', flush=True)
'''), [], foto_cmd='', controllo=figlio_morto)

print('test-verdetti: %d ok, %d errati' % (nok, nko))
sys.exit(1 if nko else 0)
