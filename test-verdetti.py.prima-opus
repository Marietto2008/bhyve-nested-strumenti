#!/usr/local/bin/python3
# test-verdetti.py -- Claude 31/10/2026, parere #167R1 §9. Regressioni OFFLINE di u64-verdetto.py, opnd-verdetto.py e
# kut-drive.py (v2): sessioni SINTETICHE (nessuna VM) e finte QEMU (script Python che simulano solo la seriale).
# Ogni caso dichiara l'uscita attesa; almeno una sessione completa per verdetto deve essere ACCETTATA.
#   test-verdetti.py <cartella di lavoro nuova>
import json, os, subprocess, sys, textwrap

B = '/mnt/linuxulator2/vm/nested-work'
PY = sys.executable
W = sys.argv[1]
os.makedirs(W)
nok = nko = 0
def esito(nome, rc, atteso, out):
	global nok, nko
	ok = rc == atteso
	nok += ok
	nko += not ok
	print('  %s %-44s uscita %s (attesa %s): %s' % ('ok    ' if ok else 'ERRATO', nome, rc, atteso, out.strip()[:110]))

# ---------------------------------------------------------------- u64
CONT = ('vm exits for instruction emulation', 'vm exits due to nested page fault')
def sess_u64(nome, casi=28, contrari=(), dup=False, fine='auto', chiuso=True, foto=(('U64 PRONTO', 0, (5, 7)),
    ('U64 FINE casi=', 0, (5, 7))), rc=None, valida=True, attesi=28, extra=()):
	d = os.path.join(W, 'u64-' + nome)
	os.makedirs(d)
	r = ['U64 INIZIO', 'U64 ATTESI casi=%d' % attesi, 'U64 PRONTO: ...', 'U64 MISURA APERTA']
	for i in range(1, casi + 1):
		r.append('U64 CASO %d mov_r8 va=... -> %s' % (i, 'CONTRARIO_AL_MODELLO' if i in contrari else 'MODELLO'))
	if dup:
		r.append('U64 CASO 1 mov_r8 va=... -> MODELLO')
	if fine == 'auto':
		r.append('U64 FINE casi=%d modello=%d contrari=%d' % (casi, casi - len(contrari), len(contrari)))
	elif fine:
		r.append(fine)
	if chiuso:
		r.append('U64 CHIUSO')
	r.extend(extra)
	open(os.path.join(d, 'seriale.txt'), 'w').write(''.join('%.3f %s\n' % (i * 0.01, x) for i, x in enumerate(r)))
	regole = []
	for ev, frc, vals in foto:
		f = os.path.join(d, 'foto-%s.txt' % ev.replace(' ', '_').strip('='))
		corpo = ''.join('%s\t%s\n' % (c, v) for c, v in zip(CONT, vals)) if vals else ''
		open(f, 'w').write('# cmd\n# evento: %s\n# rc=%s\n%s' % (ev, frc, corpo))
		regole.append({'testo': ev, 'foto': True, 'invio': 'g' if 'PRONTO' in ev else 'f',
		    'stato': 'fatta' if frc == 0 else 'fallita', 'foto_file': f, 'foto_rc': frc})
	if rc is None:
		rc = 3 if contrari else 1
	json.dump({'valida': valida, 'timeout': False, 'errori': [] if valida else ['x'], 'regole': regole,
	    'qemu_rc': rc}, open(os.path.join(d, 'stato.json'), 'w'))
	return d
def u64(nome, atteso, **k):
	d = sess_u64(nome, **k)
	p = subprocess.run([PY, B + '/u64-verdetto.py', d], capture_output=True, text=True)
	esito('u64 ' + nome, p.returncode, atteso, p.stdout + p.stderr)

print('u64-verdetto.py')
u64('completa_modello', 0)
u64('completa_un_contrario', 1, contrari=(5,))
u64('finestra_mossa', 3, foto=(('U64 PRONTO', 0, (5, 7)), ('U64 FINE casi=', 0, (6, 7))))
u64('nested_pf_mosso', 3, foto=(('U64 PRONTO', 0, (5, 7)), ('U64 FINE casi=', 0, (5, 9))))
# la riproduzione di #167R1 §4: misura aperta, nessun caso, nessun record finale; anche con stato "valida" forzato
u64('finestra_aperta_senza_fine', 5, casi=0, fine=None, chiuso=False, foto=(('U64 PRONTO', 0, (5, 7)),), rc=1)
u64('zero_casi_con_record', 5, casi=0, rc=1)
u64('ventisette_casi', 5, casi=27)
u64('caso_duplicato', 5, dup=True)
u64('foto_finale_rc_1', 5, foto=(('U64 PRONTO', 0, (5, 7)), ('U64 FINE casi=', 1, (5, 7))))
u64('foto_finale_timeout', 5, foto=(('U64 PRONTO', 0, (5, 7)), ('U64 FINE casi=', 'TIMEOUT', None)))
u64('contatore_mancante', 5, foto=(('U64 PRONTO', 0, (5,)), ('U64 FINE casi=', 0, (5, 7))))
u64('contatore_non_numerico', 5, foto=(('U64 PRONTO', 0, ('cinque', 7)), ('U64 FINE casi=', 0, (5, 7))))
u64('uscita_anticipata_senza_chiuso', 5, chiuso=False)
u64('record_incoerente', 5, fine='U64 FINE casi=28 modello=27 contrari=0')
u64('rc_incoerente_coi_contrari', 5, contrari=(3,), rc=1)
u64('codice_qemu_non_kut', 5, rc=0)
u64('driver_non_valido', 5, valida=False)
u64('prerequisito_fallito', 5, extra=('U64 PREREQ ERRATO: CR0/CR4',))

# ---------------------------------------------------------------- opnd
def sess_opnd(nome, piano='F1,F2,F3', piano_seriale=None, casi=10, ctr=4, errati_casi=(), errati_ctr=(), fine='auto', rc=None,
    timeout=False, valida=True, cont=((7, 7), (0, 0), (2, 2)), extra=(), cont_testo=None, f4=None, sonde=None, stderr=''):
	d = os.path.join(W, 'opnd-' + nome)
	os.makedirs(os.path.join(d, 'drv'))
	r = ['OPND INIZIO P0 ...', 'OPND PIANO? (F1,F2,F3 oppure F4)', 'OPND PIANO "%s" F1=1 F2=1 F3=1 F4=0' % (piano_seriale or piano)]
	if piano != 'F4':
		r.append('OPND ATTESI casi=%d controlli=%d invvpid1=1 invept1=1' % (casi, ctr))
		for i in range(1, casi + 1):
			r.append('OPND CASO F1 %d VMPTRST off=0xffc ... -> %s' % (i, 'ERRATO' if i in errati_casi else 'OK'))
		for i in range(1, ctr + 1):
			r.append('OPND CONTROLLO F1 %d VMCS corrente: 0x1 (atteso 0x1) -> %s' % (i, 'ERRATO' if i in errati_ctr
			    else 'OK'))
		r.extend(extra)
		e = len(errati_casi) + len(errati_ctr)
		if fine == 'auto':
			r.append('OPND FINE casi=%d controlli=%d errati=%d' % (casi, ctr, e))
		elif fine:
			r.append(fine)
		if rc is None:
			rc = 3 if e else 1
	else:
		r.extend(f4 or ['OPND F4 INIZIO ram=0x10000000 P1->gpa 0x40000000 ...'])
		r.extend(extra)
		if rc is None:
			rc = 255
	open(os.path.join(d, 'drv', 'seriale.txt'), 'w').write(''.join('%.3f %s\n' % (i * 0.01, x) for i, x in enumerate(r)))
	regole = [{'testo': 'OPND INIZIO', 'stato': 'fatta'}, {'testo': 'OPND PIANO?', 'stato': 'fatta'}]
	json.dump({'valida': valida, 'timeout': timeout, 'errori': [] if valida else ['x'], 'regole': regole,
	    'qemu_rc': rc}, open(os.path.join(d, 'drv', 'stato.json'), 'w'))
	if cont_testo is not None:
		open(os.path.join(d, 'contatori.txt'), 'w').write(cont_testo)
	elif cont is not None:	# il formato di opnd-manifest.sh: tre righe nell'ordine del #168 par. 3
		open(os.path.join(d, 'contatori.txt'), 'w').write('fatal_latches %d %d\nnested_vept_mmio_unemulable %d %d\n'
		    'nested_operand_fatal %d %d\n' % (cont[0] + cont[1] + cont[2]))
	if sonde is not None:
		open(os.path.join(d, 'sonde.txt'), 'w').write(sonde)
	open(os.path.join(d, 'drv', 'qemu-stderr.txt'), 'w').write(stderr)
	return d
def opnd(nome, atteso, piano='F1,F2,F3', **k):
	d = sess_opnd(nome, piano=piano, **k)
	p = subprocess.run([PY, B + '/opnd-verdetto.py', d, piano], capture_output=True, text=True)
	esito('opnd ' + nome, p.returncode, atteso, p.stdout + p.stderr)

