opnd('f4_solo_opnd', 1, piano='F4', cont=((7, 7), (0, 0), (2, 3)), sonde=SONDE_OK, stderr=STDERR_OK)
opnd('f4_doppio_incremento', 1, piano='F4', cont=((7, 9), (0, 0), (2, 4)), sonde=SONDE_OK, stderr=STDERR_OK)
opnd('contatori_formato_v2', 5, cont_testo='fatal_latches 7 7\nnested_operand_fatal 2 2\n')
opnd('contatori_riga_doppia', 5, cont_testo='fatal_latches 7 7\nnested_vept_mmio_unemulable 0 0\n'
    'nested_operand_fatal 2 2\nfatal_latches 7 7\n')
