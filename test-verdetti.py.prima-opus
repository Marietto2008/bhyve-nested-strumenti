    'FATAL_LATCH vcpu=0 errno=14 stadio=4 rip=0x405123 gpa=0x0 gla=0x600000000ffc\n'
    'FATAL_RITORNO vcpu=0 nextrip=0x405123 rip=0x405123 len=0 fatal_rip=0x405123\n')
