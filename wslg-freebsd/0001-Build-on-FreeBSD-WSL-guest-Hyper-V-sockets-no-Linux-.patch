diff --git a/libweston/backend-rdp/rdp.c b/libweston/backend-rdp/rdp.c
index 64ec132..7200509 100644
--- a/libweston/backend-rdp/rdp.c
+++ b/libweston/backend-rdp/rdp.c
@@ -38,7 +38,18 @@
 #include <sys/types.h>
 #include <sys/eventfd.h>
 #include <netdb.h>
+#ifdef __linux__
 #include <linux/vm_sockets.h>
+#else
+/* FreeBSD as a Hyper-V guest (WSL): Hyper-V sockets (sys/dev/hyperv/hvsock/hv_sock.h) instead of vsock */
+#define AF_HYPERV 43
+struct sockaddr_hvs {
+	unsigned char	sa_len;
+	sa_family_t	sa_family;
+	unsigned int	hvs_port;
+	unsigned char	hvs_zero[sizeof(struct sockaddr) - sizeof(sa_family_t) - sizeof(unsigned char) - sizeof(unsigned int)];
+};
+#endif
 #include <netinet/in.h>
 #include <fcntl.h>
 #include <arpa/inet.h>
@@ -2037,6 +2048,33 @@ static const struct weston_rdp_output_api api = {
 	rdp_output_get_primary,
 };
 
+#ifndef __linux__
+static int create_vsock_fd(int port)
+{
+	struct sockaddr_hvs socket_address;
+	int socket_fd = socket(AF_HYPERV, SOCK_STREAM | SOCK_CLOEXEC, 0);
+
+	if (socket_fd < 0) {
+		weston_log("Fail to create hvsocket");
+		return -1;
+	}
+	memset(&socket_address, 0, sizeof(socket_address));
+	socket_address.sa_len = sizeof(socket_address);
+	socket_address.sa_family = AF_HYPERV;
+	socket_address.hvs_port = port;
+	if (bind(socket_fd, (struct sockaddr *)&socket_address, sizeof(socket_address)) < 0) {
+		weston_log("Fail to bind hvsocket");
+		close(socket_fd);
+		return -2;
+	}
+	if (listen(socket_fd, 1) < 0) {
+		weston_log("Fail to listen on hvsocket");
+		close(socket_fd);
+		return -4;
+	}
+	return socket_fd;
+}
+#else
 static int create_vsock_fd(int port)
 {
 	struct sockaddr_vm socket_address;
@@ -2084,6 +2122,8 @@ static int create_vsock_fd(int port)
 	return socket_fd;
 }
 
+#endif /* __linux__ */
+
 static int use_vsock_fd(int port)
 {
 	char *fd_str = getenv("USE_VSOCK");
@@ -2106,7 +2146,9 @@ static int use_vsock_fd(int port)
 	return fd;
 }
 
+#ifdef __linux__
 extern char **environ; /* defined by libc */
+#endif
 
 static struct rdp_backend *
 rdp_backend_create(struct weston_compositor *compositor,
@@ -2193,9 +2235,12 @@ rdp_backend_create(struct weston_compositor *compositor,
 	/* For diagnostics purpose, dump all enviroment to log file */
 	/* TODO: privacy review */
 	rdp_debug(b, "RDP backend: Environment dump - start\n");
+#ifdef __linux__
+	/* FreeBSD: environ lives in crt1.o, not in libc, so a shared object linked with -z defs cannot see it */
 	for (i = 0; environ[i]; i++) {
 		rdp_debug(b, "  %s\n", environ[i]);
 	}
+#endif
 	rdp_debug(b, "RDP backend: Environment dump - end\n");
 
 #ifdef FREERDP_GIT_REVISION
diff --git a/libweston/backend-rdp/rdputil.c b/libweston/backend-rdp/rdputil.c
index 7817c98..68885bf 100644
--- a/libweston/backend-rdp/rdputil.c
+++ b/libweston/backend-rdp/rdputil.c
@@ -41,9 +41,15 @@
 
 #include "rdp.h"
 
+#ifdef __FreeBSD__
+#include <pthread_np.h>
+#endif
+
 pid_t rdp_get_tid()
 {
-#ifdef SYS_gettid
+#if defined(__FreeBSD__)
+	return pthread_getthreadid_np();
+#elif defined(SYS_gettid)
 	return syscall(SYS_gettid);
 #else
 	return gettid();
@@ -173,7 +179,12 @@ rdp_allocate_shared_memory(struct rdp_backend *b, struct weston_rdp_shared_memor
 		goto error_exit;
 	}
 
+#ifdef __linux__
 	if (fallocate(fd, 0, 0, shared_memory->size) < 0) {
+#else
+	/* posix_fallocate() returns the error instead of setting errno */
+	if ((errno = posix_fallocate(fd, 0, shared_memory->size)) != 0) {
+#endif
 		rdp_debug_error(b, "%s: Failed to allocate %d: \"%s\" %ld bytes with error: %s\n",
 			__func__, fd, path, shared_memory->size, strerror(errno));
 		goto error_exit;
