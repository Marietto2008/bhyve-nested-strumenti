nok = nko = 0
def esito(nome, rc, atteso, out):
	global nok, nko
	ok = rc == atteso
	nok += ok
	nko += not ok
	print('  %s %-44s uscita %s (attesa %s): %s' % ('ok    ' if ok else 'ERRATO', nome, rc, atteso, out.strip()[:110]))

# ---------------------------------------------------------------- u64
CONT = ('vm exits for instruction emulation', 'vm exits due to nested page fault')
def sess_u64(nome, casi=28, contrari=(), dup=False, fine='auto', chiuso=True, foto=(('U64 PRONTO', 0, (5, 7)),
    ('U64 FINE casi=', 0, (5, 7))), rc=None, valida=True, attesi=28, extra=()):
	d = os.path.join(W, 'u64-' + nome)
	os.makedirs(d)
	r = ['U64 INIZIO', 'U64 ATTESI casi=%d' % attesi, 'U64 PRONTO: ...', 'U64 MISURA APERTA']
	for i in range(1, casi + 1):
		r.append('U64 CASO %d mov_r8 va=... -> %s' % (i, 'CONTRARIO_AL_MODELLO' if i in contrari else 'MODELLO'))
	if dup:
		r.append('U64 CASO 1 mov_r8 va=... -> MODELLO')
	if fine == 'auto':
		r.append('U64 FINE casi=%d modello=%d contrari=%d' % (casi, casi - len(contrari), len(contrari)))
	elif fine:
		r.append(fine)
	if chiuso:
		r.append('U64 CHIUSO')
	r.extend(extra)
	open(os.path.join(d, 'seriale.txt'), 'w').write(''.join('%.3f %s\n' % (i * 0.01, x) for i, x in enumerate(r)))
	regole = []
	for ev, frc, vals in foto:
		f = os.path.join(d, 'foto-%s.txt' % ev.replace(' ', '_').strip('='))
		corpo = ''.join('%s\t%s\n' % (c, v) for c, v in zip(CONT, vals)) if vals else ''
		open(f, 'w').write('# cmd\n# evento: %s\n# rc=%s\n%s' % (ev, frc, corpo))
		regole.append({'testo': ev, 'foto': True, 'invio': 'g' if 'PRONTO' in ev else 'f',
		    'stato': 'fatta' if frc == 0 else 'fallita', 'foto_file': f, 'foto_rc': frc})
	if rc is None:
		rc = 3 if contrari else 1
	json.dump({'valida': valida, 'timeout': False, 'errori': [] if valida else ['x'], 'regole': regole,
	    'qemu_rc': rc}, open(os.path.join(d, 'stato.json'), 'w'))
	return d
def u64(nome, atteso, **k):
	d = sess_u64(nome, **k)
	p = subprocess.run([PY, B + '/u64-verdetto.py', d], capture_output=True, text=True)
	esito('u64 ' + nome, p.returncode, atteso, p.stdout + p.stderr)

