# ---------------------------------------------------------------- opnd (v4, #169 R2)
# Fixture REALISTICHE: le righe CASO/CONTROLLO nel formato di opnd_test.c.inc, generate da un modello SCRITTO QUI (non
# importato dal verdetto); il controllo statico in fondo lo confronta col SORGENTE C.
M_OFF8 = ['0xffc', '0xff9', '0xfff', '0x100']
M_OFF16 = ['0xff8', '0xff1', '0x100']
M_ISTR8 = ['VMPTRST', 'VMPTRLD', 'VMCLEAR', 'VMREAD', 'VMWRITE']
M_CTRL = ['VMCS corrente dopo VMPTRLD', 'VMCS corrente dopo VMCLEAR', 'GUEST_RIP del VMCS di lavoro dopo VMWRITE']
M_S10_CTRL = ['GUEST_RIP invariato dopo VMWRITE K2 (memoria)', 'destinazione di VMREAD K2 invariata (registro)',
    'GUEST_RIP invariato dopo VMWRITE K2 (registro)']
M_F3 = ['VMPTRLD', 'INVVPID', 'INVVPID_tipo4_non_annunciato', 'VMXON_VMX_gia_attiva', 'VMCLEAR', 'VMPTRST', 'INVEPT',
    'VMREAD', 'VMWRITE', 'VMXOFF', 'VMLAUNCH', 'VMRESUME']
def righe_f123(piano, iv=1, ie=1, etichetta=None):
	c, k = [], []
	for f in piano.split(','):
		passi = {'F1': [('F1', 'ok')], 'F2': [('F2', 'P1_assente'), ('F2', 'P1_sola_lettura')]}.get(f, [])
		for fase, var in passi:
			for o in M_OFF8:
				for i, x in enumerate(M_ISTR8):
					c.append((etichetta or fase, '%s off=%s var=%s vec=0 err=0 cr2=0 rflags=0x2 vmerr=0 memoria=come_attesa '
					    'atteso(vec=0 err=0 cr2=0 vmerr=0) nota' % (x, o, var)))
					if x in ('VMPTRLD', 'VMCLEAR', 'VMWRITE'):
						k.append((etichetta or fase, M_CTRL[['VMPTRLD', 'VMCLEAR', 'VMWRITE'].index(x)]))
			for o in M_OFF16:
				for x in ['INVVPID'] * iv + ['INVEPT'] * (2 * ie):
					c.append((etichetta or fase, '%s off=%s var=%s vec=0 err=0 cr2=0 rflags=0x2 vmerr=0 memoria=come_attesa '
					    'atteso(vec=0 err=0 cr2=0 vmerr=0) tipo' % (x, o, var)))
			if fase == 'F1':			# stadio 10: opnd_s10, una volta dopo il passaggio F1
				s10 = [('VMREAD', '0x100'), ('VMWRITE', '0x100'), ('VMREAD_R', '0x100'), ('VMWRITE_R', '0x100')] + \
				    [('INVVPID', '0xff8')] * iv + [('INVEPT', '0xff8')] * (2 * ie)
				for x, o in s10:
					c.append((etichetta or 'F1', '%s off=%s var=s10 vec=0 err=0 cr2=0 rflags=0x42 vmerr=12 '
					    'memoria=come_attesa atteso(vec=0x100 err=0 cr2=0 vmerr=12) K2' % (x, o)))
				k.extend((etichetta or 'F1', n) for n in M_S10_CTRL)
		if f == 'F3':
			for x in M_F3:
				c.append(('F3', '%s cpl3 #GP=si atteso(#GP prima di ogni accesso e di ogni VMfail)' % x))
	return c, k
STDERR_OK = ('bhyve-mmap: pc.ram GPA=0xc3000 size=0x25000 segid=1 memflags=0x2 (wired=1)\n'
    'Error running vm: State not recoverable (errno=95, error=-1)\n'
    'bhyve: vCPU 0: VM_RUN State not recoverable (errno=95): errore non transitorio; porta chiusa, nessun nuovo VM_RUN; '
    'RIP del registro 0x405123\n'
    'bhyve: porta della VM chiusa dal vCPU 0: nessun vCPU rientra; arresto della VM richiesto (VM_RUN non recuperabile)\n')
SONDE_F123 = ('DTRACE_ATTIVO\nFBT nested_operand_copy 120\nFBT nested_vmread 41\nFBT nested_vmwrite 37\nDTRACE_FINE\n')
SONDE_OK = ('DTRACE_ATTIVO\nOPNDFATAL vcpu=0 stadio=4 err=14 rip=0x405123 gla=0x600000000ffc\n'
    'FATAL_LATCH vcpu=0 errno=14 stadio=4 rip=0x405123 gpa=0x0 gla=0x600000000ffc\n'
    'FATAL_RITORNO vcpu=0 nextrip=0x405123 rip=0x405123 len=0 fatal_rip=0x405123\n'
    'FBT nested_operand_copy 3\nFBT nested_vmread 2\nFBT nested_vmwrite 2\nDTRACE_FINE\n')
def sess_opnd(nome, piano='F1,F2,F3', piano_seriale=None, iv=1, ie=1, attesi=None, errati_casi=(), errati_ctr=(),
    fine='auto', rc=None, timeout=False, valida=True, errori=None, regole=None, invii=None, cont='auto', cont_testo=None,
    dmesg='', extra=(), togli=(), f4=None, sonde=None, stderr=None, etichetta=None, summary=True, ritocca=None,
    sonde_err='', modo=None, ombra_ap='0', ombra_ch='0', shv=None, manifest=None):
	d = os.path.join(W, 'opnd-' + nome)
	os.makedirs(os.path.join(d, 'drv'))
	r = ['OPND INIZIO P0 ...', 'OPND MSR ctls2 0x6fbff00000000 (enable EPT 1, enable VPID 1) ept_vpid 0xf0106534141 (INVEPT 1, INVVPID 1)', 'OPND PIANO? (F1,F2,F3 oppure F4)',
	    'OPND PIANO "%s" F1=1 F2=1 F3=1 F4=0' % (piano_seriale or piano)]
	if piano != 'F4':
		c, k = righe_f123(piano, iv, ie, etichetta)
		r.append(attesi or 'OPND ATTESI casi=%d controlli=%d invvpid1=%d invept1=%d' % (len(c), len(k), iv, ie))
		e = 0
		for i, (fase, testo) in enumerate(c, 1):
			r.append('OPND CASO %s %d %s -> %s' % (fase, i, testo, 'ERRATO' if i in errati_casi else 'OK'))
			e += i in errati_casi
		for i, (fase, cosa) in enumerate(k, 1):
			r.append('OPND CONTROLLO %s %d %s: 0x1 (atteso 0x1) -> %s' % (fase, i, cosa, 'ERRATO' if i in errati_ctr else 'OK'))
			e += i in errati_ctr
		r = [x for x in r if not any(x.startswith(t) for t in togli)]
		r.extend(extra)
		if fine == 'auto':
			r.append('OPND FINE casi=%d controlli=%d errati=%d' % (len(c), len(k), e))
		elif fine:
			r.append(fine)
		if summary:
			r.append('SUMMARY: 1 tests' + (', 1 unexpected failures' if e else ''))
		if rc is None:
			rc = 3 if e else 1
		if cont == 'auto':
			cont = ((7, 7), (0, 0), (2, 2))
		if sonde is None:
			sonde = SONDE_F123
		if stderr is None:
			stderr = ''
		reg = ['OPND INIZIO', 'OPND PIANO?', 'OPND FINE casi=']
	else:
		r.extend(f4 or ['OPND F4 INIZIO ram=0x10000000 P1->gpa 0x40000000 ...'])
		r = [x for x in r if not any(x.startswith(t) for t in togli)]
		r.extend(extra)
		if summary is True:
			summary = False
		if summary:
			r.append('SUMMARY: 1 tests')
		if rc is None:
			rc = 1			# contratto della QEMU protetta (host-error, EXIT_FAILURE)
		if cont == 'auto':
			cont = ((7, 8), (0, 0), (2, 3))
		if sonde is None:
			sonde = SONDE_OK
		if stderr is None:
			stderr = STDERR_OK
		reg = ['OPND INIZIO', 'OPND PIANO?']
	open(os.path.join(d, 'drv', 'seriale.txt'), 'w').write(''.join('%.3f %s\n' % (i * 0.01, x) for i, x in enumerate(r)))
	regole_j = [{'testo': t, 'stato': 'fatta'} for t in reg] if regole is None else regole
	invii_j = [{'regola': 'OPND PIANO?', 'invio': piano, 't': 0.1}] if invii is None else invii
	stj = {'valida': valida, 'timeout': timeout, 'errori': ([] if valida else ['x']) if errori is None else errori,
	    'regole': regole_j, 'invii': invii_j, 'qemu_rc': rc}
	if ritocca:
		ritocca(stj)
	json.dump(stj, open(os.path.join(d, 'drv', 'stato.json'), 'w'))
	if cont_testo is not None:
		open(os.path.join(d, 'contatori.txt'), 'w').write(cont_testo)
	elif cont is not None:
		open(os.path.join(d, 'contatori.txt'), 'w').write('fatal_latches %d %d\nnested_vept_mmio_unemulable %d %d\n'
		    'nested_operand_fatal %d %d\n' % (cont[0] + cont[1] + cont[2]))
	if sonde is not False:
		open(os.path.join(d, 'sonde.txt'), 'w').write(sonde)
	if sonde_err is not None:
		open(os.path.join(d, 'sonde-err.txt'), 'w').write(sonde_err)
	if sonde is not False and shv is not None:		# parere Opus C1: ingressi in vmx_shvmcs_enter (ombra)
		open(os.path.join(d, 'sonde.txt'), 'w').write(sonde.replace('DTRACE_FINE', 'FBT vmx_shvmcs_enter %d\nDTRACE_FINE' % shv))
	if manifest is None:
		manifest = ('sessione: APERTA\npiano %s modo %s timeout 300\nnested_shadow_vmcs %s\navvio sessione: 1\n'
		    'nested_shadow_vmcs alla chiusura %s\nsessione: CHIUSA\n' % (piano, modo or ('--esegui-d' if piano == 'F4' else
		    '--esegui'), ombra_ap, ombra_ch))
	if manifest is not False:
		open(os.path.join(d, 'manifest.txt'), 'w').write(manifest)
	if dmesg is not None:
		open(os.path.join(d, 'dmesg-sessione.txt'), 'w').write(dmesg)
	if stderr is not False:
		open(os.path.join(d, 'drv', 'qemu-stderr.txt'), 'w').write(stderr)
	return d
def opnd(nome, atteso, piano='F1,F2,F3', **k):
	d = sess_opnd(nome, piano=piano, **k)
	p = subprocess.run([PY, B + '/opnd-verdetto.py', d, piano], capture_output=True, text=True)
	esito('opnd ' + nome, p.returncode, atteso, p.stdout + p.stderr)
