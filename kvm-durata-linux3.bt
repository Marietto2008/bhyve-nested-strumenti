/*
 * kvm-durata-linux3.bt -- Claude 11/11/2026, terza versione di kvm-episodi-linux.bt per la diagnosi 025 di Fable (§1.5):
 * durata dell'emulazione di Hyper-V sotto KVM sugli episodi veri, cioe' da kvm_nested_vmexit_inject (48 riflessa a
 * Hyper-V) al kvm_nested_vmenter successivo con lo stesso VMCS12 (Hyper-V rientra nell'L2). Sotto bhyve, record delle
 * 14:50: E2-E0 = 271.982 tsc, ~75 us.
 * Come kvm-episodi-linux2.bt (filtro guest_rip nella pagina 0xffffffff8120b000, @qual ogni 60 s) piu':
 *   @us[classe]       istogramma della durata in microsecondi, per classe (0 = rip0+6, 1 = altro, 2 = fermo);
 *   @st[classe]       count/avg/total in ns, ogni 60 s;
 *   @altro_thread     episodi chiusi su un thread (vCPU dell'L1) diverso da quello della 48.
 * Istogrammi stampati ogni 300 s e in END.
 * Uso: sudo bpftrace kvm-durata-linux3.bt > ../dati-kvm/durata3-<ora>.txt
 */
tracepoint:kvm:kvm_nested_vmenter
{
	$p = args->vmcb;
	@cur[tid] = $p;
	$r0 = @pend[$p];
	if ($r0 != 0) {
		$ev = (args->event_inj & 0x80000000) != 0 ? 1 : 0;
		$cls = args->nested_rip == $r0 ? 2 : (args->nested_rip == $r0 + 6 ? 0 : 1);
		@e0c[$cls, $ev] = count();
		$d = nsecs - @t0[$p];
		@us[$cls] = hist($d / 1000);
		@st[$cls] = stats($d);
		if (@tid0[$p] != tid) { @altro_thread = count(); }
		if ($cls == 2 && args->event_inj == 0x80000b0e) {
			printf("%s #PF FERMO: vmcs12 %lx rip %lx eptp12 %lx idtv_ultima_48 %x durata %d ns\n",
			    strftime("%H:%M:%S", nsecs), $p, args->nested_rip, args->guest_pgd, @idtv[$p], $d);
		}
		delete(@pend[$p]);
	}
}

tracepoint:kvm:kvm_page_fault
/(args->fault_address == 0xfee00380 || args->fault_address == 0xfee00320) &&
 (args->guest_rip & 0xfffffffffffff000) == 0xffffffff8120b000/
{
	@pfrip[tid] = args->guest_rip;
	@pft[tid] = nsecs;
}

tracepoint:kvm:kvm_nested_vmexit_inject
/args->exit_code == 48/
{
	$p = @cur[tid];
	@idtv[$p] = args->exit_info2;
	if (@pfrip[tid] != 0 && nsecs - @pft[tid] < 50000) {
		@pend[$p] = @pfrip[tid];
		@t0[$p] = nsecs;
		@tid0[$p] = tid;
		@episodi = count();
		@qual[args->exit_info1] = count();
	}
	delete(@pfrip[tid]);
}

interval:s:60
{
	time("%H:%M:%S ");
	print(@episodi);
	print(@e0c);
	print(@qual);
	print(@st);
	print(@altro_thread);
}

interval:s:300
{
	time("%H:%M:%S istogrammi\n");
	print(@us);
}

END
{
	clear(@cur); clear(@pend); clear(@pfrip); clear(@pft); clear(@idtv); clear(@t0); clear(@tid0);
}
