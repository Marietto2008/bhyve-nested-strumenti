#!/bin/sh
O=/mnt/linuxulator2/vm/wsl2/fbsd/logs/udstate-$(date +%Y%m%d-%H%M); mkdir -p $O
SP=/tmp/claude-1001/-mnt-linuxulator2-freebsd-radxa-src/b3d0f7b6-b200-4070-a188-1436b7dd0836/scratchpad
N=/mnt/linuxulator2/vm/wsl2/fbsd/freebsd-nested/tools/nested
D=/mnt/linuxulator2/vm/wsl2/fbsd/dtrace
DISPLAY=:0; XAUTHORITY=/home/marietto/.Xauthority; export DISPLAY XAUTHORITY
mount | grep -q "/mnt/da0p2" || sudo -n mount -t ufs /dev/da0p2 /mnt/da0p2
sudo -n sysctl hw.vmm.vmx.diag_ud=1 >/dev/null
sudo -n bhyvectl --vm=vm0:12 --destroy 2>/dev/null
sudo -n dtrace -s $D/win-udstate.d -o $O/ud.txt 2>/dev/null &
sleep 4
sudo -n sh $N/12-Windows-11-vm12-senza-gpu > $O/script.log 2>&1 &
i=0; while [ $i -lt 60 ]; do [ -e /dev/vmm/vm0:12 ] && break; sleep 1; i=$((i+1)); done
[ -e /dev/vmm/vm0:12 ] || { echo "VM NON creata"; exit 1; }
echo "VM su; attendo UDA e leggo la pagina del RIP (CR3 walk, VM viva)"
done=""
for t in $(seq 1 300); do
  line=$(grep -m1 "^UDA " $O/ud.txt 2>/dev/null)
  if [ -n "$line" ]; then
    cr3=$(echo "$line"|grep -oE 'cr3=0x[0-9a-f]+'|cut -d= -f2)
    rip=$(echo "$line"|grep -oE 'rip=0x[0-9a-f]+'|cut -d= -f2)
    cr4=$(echo "$line"|grep -oE 'cr4=0x[0-9a-f]+'|cut -d= -f2)
    echo "UDA: $line"
    base=$(printf '0x%x' $(( $rip - 0x20 )))
    echo "=== CR3 walk di $base (cr3=$cr3, cr4=$cr4; PCID nei 12 bit bassi, LA57=bit12 di cr4) ==="
    sudo -n python3 $SP/gva.py $cr3 $base 96 $O/code.bin | tee $O/walk.txt
    pbase=$(printf '0x%x' $(( $rip & ~0xfff )))
    sudo -n python3 $SP/gva.py $cr3 $pbase 4096 $O/page.bin >/dev/null 2>&1
    echo "offset del RIP in pagina: $(printf '0x%x' $(( $rip & 0xfff )))"
    done="$cr3 $rip"; break
  fi
  sleep 0.2
done
[ -z "$done" ] && echo "nessun UDA catturato"
b=$(pgrep -x bhyve); [ -n "$b" ] && { sudo -n kill -KILL $b; sleep 2; }
sudo -n bhyvectl --vm=vm0:12 --destroy 2>/dev/null
sudo -n pkill -KILL -f "win-udstate|vncviewer" 2>/dev/null
sudo -n sysctl hw.vmm.vmx.diag_ud=0 >/dev/null
echo "=== record UD completi:"; grep -E "^UD[ABC] " $O/ud.txt | head -12
echo "OUTPUT: $O ; GOT: $done"
ls /dev/vmm 2>/dev/null || echo "/dev/vmm pulito"
