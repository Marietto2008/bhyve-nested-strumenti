/* callout-cpu.d -- Claude 16/11/2026, prova (b) v2: per ogni CPU dell'L2, cc_lastscan e cc_firstevent del callout
 * (kern_timeout.c; callout_cc_add sposta a cc_lastscan i callout piu' vecchi) contro l'ora (timehands->th_offset).
 * Una clausola BEGIN per CPU: un errore non cancella le altre. Indirizzi per-CPU a 64 bit espliciti. */
BEGIN { this->th = `timehands; ora = (int64_t)((this->th->th_offset.sec << 32) + (this->th->th_offset.frac >> 32)); printf("ora_s=%d base=0x%x\n", ora >> 32, (uint64_t)&`pcpu_entry_cc_cpu); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[0] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu0 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[1] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu1 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[2] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu2 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[3] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu3 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[4] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu4 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[5] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu5 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[6] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu6 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { this->a = ((uint64_t *)&`dpcpu_off)[7] + (uint64_t)&`pcpu_entry_cc_cpu; this->cc = (struct callout_cpu *)this->a; printf("cpu7 a=0x%x lastscan_s=%d firstevent_s=%d lastscan-ora_ms=%d firstevent-ora_ms=%d\n", this->a, this->cc->cc_lastscan >> 32, this->cc->cc_firstevent >> 32, ((this->cc->cc_lastscan - ora) * 1000) >> 32, ((this->cc->cc_firstevent - ora) * 1000) >> 32); }
BEGIN { exit(0); }
