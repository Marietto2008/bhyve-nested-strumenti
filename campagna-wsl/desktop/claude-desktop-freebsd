#!/bin/sh
# claude-desktop -- Claude 04/11/2026. Il desktop XFCE di FreeBSD in una finestra di WSLg, con la schermata di login
# di xdm: prima WSLg (wslg-avvia: Weston + msrdc, finestre con la memoria condivisa /dev/wslgshm), poi Xephyr come
# schermo dentro WSLg (:0), xdm ci mette il login, dopo il login parte ~/.xsession (XFCE). Xephyr sceglie da se' il
# primo display libero (-displayfd). Lo lancia Avvia-FreeBSD.cmd sul Desktop di Windows
# (wsl -d FreeBSD -u root -e /usr/local/sbin/claude-desktop).
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/lib/wsl/bin
N=/var/run/claude-xephyr.display
pkill -x xdm 2>/dev/null; pkill -x Xephyr 2>/dev/null; pkill -x weston 2>/dev/null; sleep 1
mkdir -p /tmp/wslg-runtime
wslg-avvia rail > /var/log/claude-wslg.log 2>&1 &
export DISPLAY=:0
i=0; until xdpyinfo > /dev/null 2>&1 || [ $i -ge 60 ]; do sleep 1; i=$((i + 1)); done
xdpyinfo > /dev/null 2>&1 || { echo 'WSLg non parte: vedi /var/log/claude-wslg.log'; tail -5 /var/log/claude-wslg.log; exit 1; }
: > $N
Xephyr -displayfd 5 -ac -screen 1536x800 -title 'FreeBSD - XFCE' -resizeable -no-host-grab \
	5> $N > /var/log/claude-xephyr.log 2>&1 &
i=0; until [ -s $N ] || [ $i -ge 30 ]; do sleep 1; i=$((i + 1)); done
D=:$(cat $N)
DISPLAY=$D xdpyinfo > /dev/null 2>&1 || { echo 'Xephyr non parte: vedi /var/log/claude-xephyr.log'; tail -5 /var/log/claude-xephyr.log; exit 1; }
echo "FreeBSD: schermata di login nella finestra 'FreeBSD - XFCE' (display $D): utente marietto, password a."
echo 'Non chiudere questa finestra: chiudendola si ferma il desktop.'
# niente file del pid: xdm 1.1.14 lo crea con O_EXCL e non parte se esiste gia', e dopo un arresto brusco (panic,
# wsl --shutdown) resta sul disco persistente ("Can't lock pid file", 04/11 08:18). Che ce ne sia uno solo lo
# garantisce il pkill qui sopra.
exec xdm -nodaemon -server "$D foreign" -udpPort 0 -xrm 'DisplayManager.pidFile:' -error /var/log/claude-xdm.log
